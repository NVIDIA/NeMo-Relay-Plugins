{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "type": {
      "enum": [
        "worker",
        "native"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux-x86_64",
          "linux-arm64",
          "windows-x86_64",
          "windows-arm64",
          "macos-arm64"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "description",
        "license"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "enum": [
            "in-tree",
            "remote"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "location",
        "path"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "location": {
                "const": "remote"
              }
            }
          },
          "then": {
            "required": [
              "repository",
              "ref",
              "sha"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "repository"
                  ]
                },
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "sha"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^3\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "rust": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "python"
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cwd": {
              "enum": [
                "source",
                "plugin"
              ]
            }
          },
          "required": [
            "argv",
            "cwd"
          ]
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cwd": {
              "enum": [
                "source",
                "plugin"
              ]
            }
          },
          "required": [
            "argv",
            "cwd"
          ]
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cwd": {
              "enum": [
                "source",
                "plugin"
              ]
            }
          },
          "required": [
            "argv",
            "cwd"
          ]
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cwd": {
              "enum": [
                "source",
                "plugin"
              ]
            }
          },
          "required": [
            "argv",
            "cwd"
          ]
        }
      },
      "required": [
        "build",
        "test",
        "package",
        "smoke"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bundle",
        "manifest"
      ]
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [],
      "not": {
        "required": [
          "tag",
          "sha"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "type",
    "metadata",
    "source",
    "toolchains",
    "commands",
    "artifacts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
